<resources>

    <style name="Base.Theme.DropBy" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="actionBarSize">64dp</item>

        <item name="colorPrimary">@color/db_accent</item>
        <item name="colorPrimaryVariant">@color/db_accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/theater_red</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorSurface">@color/db_surface</item>
        <item name="colorOnSurface">@color/db_text_primary</item>

        <item name="colorError">@color/db_error</item>
        <item name="colorOnError">@color/white</item>

        <item name="android:colorBackground">@color/db_background</item>
        <item name="android:windowBackground">@color/db_background</item>

        <item name="android:textColorPrimary">@color/db_text_primary</item>
        <item name="android:textColorSecondary">@color/db_text_secondary</item>
        <item name="android:textColorHint">@color/db_text_hint</item>
        <item name="android:editTextColor">@color/db_text_primary</item>

        <item name="android:statusBarColor">#121212</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Global Font Settings -->
        <item name="android:fontFamily">@font/body_font</item>
        <item name="fontFamily">@font/body_font</item>

        <!-- Material Typography (Ensures font applies to all Material Components) -->
        <item name="textAppearanceHeadline1">@style/DropBy.TextAppearance.Title</item>
        <item name="textAppearanceHeadline2">@style/DropBy.TextAppearance.Title</item>
        <item name="textAppearanceHeadline3">@style/DropBy.TextAppearance.Title</item>
        <item name="textAppearanceHeadline4">@style/DropBy.TextAppearance.Title</item>
        <item name="textAppearanceHeadline5">@style/DropBy.TextAppearance.Title</item>
        <item name="textAppearanceHeadline6">@style/DropBy.TextAppearance.Title</item>
        <item name="textAppearanceSubtitle1">@style/DropBy.TextAppearance.Subtitle</item>
        <item name="textAppearanceSubtitle2">@style/DropBy.TextAppearance.Subtitle</item>
        <item name="textAppearanceBody1">@style/DropBy.TextAppearance.Subtitle</item>
        <item name="textAppearanceBody2">@style/DropBy.TextAppearance.Subtitle</item>
        <item name="textAppearanceCaption">@style/DropBy.TextAppearance.Caption</item>
        <item name="textAppearanceButton">@style/DropBy.TextAppearance.Subtitle</item>

        <!-- Widget Styles -->
        <item name="android:textViewStyle">@style/AppTextView</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <item name="android:editTextStyle">@style/AppEditText</item>
    </style>

    <style name="Theme.DropBy" parent="Base.Theme.DropBy" />
    <style name="DropBy" parent="Base.Theme.DropBy" />

</resources>
