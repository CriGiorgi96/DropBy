<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/db_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">

        <!-- Icona email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✉️"
            android:textSize="56sp"
            android:layout_marginBottom="16dp" />

        <!-- Titolo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/verify_your_account"
            android:textColor="@color/db_text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="10dp" />

        <!-- Sottotitolo (email dinamica) -->
        <TextView
            android:id="@+id/tvVerificationSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sent_code_to_email"
            android:textColor="@color/db_text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Input OTP -->
        <EditText
            android:id="@+id/etOtpCode"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="@string/six_character_code"
            android:inputType="number"
            android:maxLength="6"
            android:textSize="22sp"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:layout_marginBottom="20dp" />

        <!-- ProgressBar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Bottone verifica -->
        <Button
            android:id="@+id/btnVerifyOtp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/verify"
            android:backgroundTint="#7B1FA2"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Reinvia codice -->
        <Button
            android:id="@+id/btnResendOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/did_not_receive_code"
            android:backgroundTint="@android:color/transparent"
            android:textColor="@color/db_text_secondary"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>