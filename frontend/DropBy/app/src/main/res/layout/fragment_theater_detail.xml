<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_theater_detail.xml
  IDs richiesti da TheaterDetailFragment.java:
    - theaterGalleryImage          (ImageView)
    - theaterPreviousImageButton   (TextView)
    - theaterNextImageButton       (TextView)
    - theaterNameText              (TextView)
    - theaterAddressText           (TextView)
    - theaterDetailsText           (TextView)
    - theaterServicesText          (TextView)
    - theaterFloorPlanButton       (Button)
    - theaterEventsStatusText      (TextView)
    - theaterEventsRecyclerView    (RecyclerView)  ← sostituisce il vecchio LinearLayout
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/db_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="vertical">

        <!-- ── GALLERIA IMMAGINI ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/theaterGalleryImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/theater_photo"
                android:scaleType="centerCrop" />

            <!-- Navigazione galleria -->
            <TextView
                android:id="@+id/theaterPreviousImageButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="8dp"
                android:background="#88000000"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/theaterNextImageButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:background="#88000000"
                android:gravity="center"
                android:text="›"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:visibility="gone" />

        </FrameLayout>

        <!-- ── INFO TEATRO ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/theaterNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/db_text_primary"
                android:textSize="22sp"
                style="@style/AppTitle" />

            <TextView
                android:id="@+id/theaterAddressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/db_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/theaterDetailsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/db_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/theaterServicesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/db_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/theaterDescriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/db_text_primary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Pulsanti azione -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/theaterFloorPlanButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/db_accent_dark"
                    android:text="@string/floor_plan"
                    android:textColor="@color/db_text_primary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/theaterDirectionsButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/db_accent_light"
                    android:text="@string/directions"
                    android:textColor="@color/db_text_primary"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Separatore -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="18dp"
                android:background="#E0E0E0" />

            <!-- ── SEZIONE EVENTI ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scheduled"
                android:textColor="@color/db_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/checkShowPastEvents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/show_past_events"
                android:textColor="@color/db_text_secondary"
                android:textSize="14sp"
                android:checked="false" />

            <TextView
                android:id="@+id/theaterEventsStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:visibility="visible" />

            <!-- Container eventi: LinearLayout statico, nessuna RecyclerView -->
            <LinearLayout
                android:id="@+id/theaterEventsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>