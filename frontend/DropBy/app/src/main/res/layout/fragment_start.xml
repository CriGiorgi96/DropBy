<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/startLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF050306">

    <com.example.dropby.views.VideoBackgroundView
        android:id="@+id/loginBackgroundVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/loginVideoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/login_video_overlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.1" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.9" />

    <ScrollView
        android:id="@+id/startScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/guidelineStart"
        app:layout_constraintEnd_toEndOf="@id/guidelineEnd">

        <LinearLayout
            android:id="@+id/welcomeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical" >

            <ImageView
                android:id="@+id/titleLogo"
                android:layout_width="match_parent"
                android:layout_height="264dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/title_intro" />

            <LinearLayout
                android:id="@+id/masksDivider"
                android:layout_width="280dp"
                android:layout_height="38dp"
                android:layout_marginTop="0dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:alpha="0.9"
                    android:background="#D6B56D" />

                <ImageView
                    android:id="@+id/masksIcon"
                    android:layout_width="50dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/maschere_intro" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:alpha="0.9"
                    android:background="#D6B56D" />
            </LinearLayout>

            <TextView
                android:id="@+id/presentation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxWidth="320dp"
                android:maxLines="3"
                android:text="@string/descriptionEventsTop"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:lineSpacingExtra="1dp"
                android:shadowColor="#D6000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="10" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="320dp"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/login_primary_button_bg"
                android:elevation="8dp"
                android:text="@string/login_button"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="320dp"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                app:backgroundTint="#26000000"
                app:cornerRadius="999dp"
                app:strokeColor="#B8FFFFFF"
                app:strokeWidth="1dp"
                android:text="@string/register_button"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <!-- Bottone Continua come ospite -->
            <TextView
                android:id="@+id/btnGuest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="44dp"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="@string/continue_guest"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <LinearLayout
                android:id="@+id/languageButtonsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnLanguageIt"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_language_normal"
                    android:padding="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/italy"
                    android:contentDescription="Italiano" />

                <ImageButton
                    android:id="@+id/btnLanguageEn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_language_normal"
                    android:padding="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/uk"
                    android:contentDescription="English" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
