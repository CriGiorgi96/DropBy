<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Titolo -->
    <TextView
        android:id="@+id/tvDeleteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/delete_account"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:textStyle="bold"
        style="@style/AppTitle"
        android:layout_marginBottom="16dp" />

    <!-- Warning -->
    <TextView
        android:id="@+id/tvDeleteWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permanent_delete"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <!-- Input per conferma -->
    <EditText
        android:id="@+id/etDeleteConfirm"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="@string/write_confirm"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Bottone per annullare -->
        <Button
            android:id="@+id/btnDeleteCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/exit"
            android:textStyle="bold"/>

        <!-- Bottone per confermare -->
        <Button
            android:id="@+id/btnDeleteConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/send"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>
