<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_event_detail.xml
  IDs richiesti da EventDetailFragment.java:
    - eventDetailPoster              (ImageView)
    - eventDetailTitle               (TextView)
    - eventDetailCategory            (TextView)
    - eventDetailDate                (TextView)
    - eventDetailCity                (TextView)
    - eventDetailDescription         (TextView)
    - eventDetailPrice               (TextView)
    - eventDetailTicketButton        (Button)
    - eventDetailReplicasLabel       (TextView)
    - eventDetailReplicasStatus      (TextView)
    - eventDetailReplicasRecyclerView (RecyclerView)
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF8F5FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="vertical">

        <!-- ── LOCANDINA ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp">

            <ImageView
                android:id="@+id/eventDetailPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/event_poster"
                android:scaleType="centerCrop" />

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="@string/add_to_favourites"
                android:padding="8dp"
                android:src="@drawable/ic_favorite_border"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:visibility="gone" />

        </FrameLayout>

        <!-- ── CORPO ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Categoria -->
            <TextView
                android:id="@+id/eventDetailCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#EDE7F6"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#7B1FA2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Titolo -->
            <TextView
                android:id="@+id/eventDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#1A1A2E"
                android:textSize="24sp"
                android:textStyle="bold"
                style="@style/AppTitle"/>

            <!-- Data e orario -->
            <TextView
                android:id="@+id/eventDetailDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:drawablePadding="6dp"
                android:textColor="#6A6274"
                android:textSize="14sp"
                style="@style/AppTextLight"/>

            <!-- Città -->
            <TextView
                android:id="@+id/eventDetailCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#6A6274"
                android:textSize="14sp"
                style="@style/AppTextLight"/>

            <!-- Separatore -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="#E0E0E0" />

            <!-- Descrizione -->
            <TextView
                android:id="@+id/eventDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.4"
                android:textColor="#333333"
                android:textSize="16sp"/>

            <!-- Link approfondimento (Wikipedia / info_url) -->
            <TextView
                android:id="@+id/eventDetailInfoLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="4dp"
                android:textColor="#7B1FA2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Pulsante biglietti -->
            <Button
                android:id="@+id/eventDetailTicketButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#7B1FA2"
                android:text="@string/buy_tickets"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:visibility="gone" />

            <!-- ── SEZIONE RECENSIONI ── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="#E0E0E0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reviews"
                android:textColor="#1A1A2E"
                android:textSize="20sp"
                style="@style/AppTitle" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/reviewsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/reviewsStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="#9E9E9E"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Form aggiunta recensione (solo per utenti loggati) -->
            <LinearLayout
                android:id="@+id/reviewFormLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#F3E5F5"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/write_review"
                    android:textColor="#6A1B9A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Box stile TicketOne: visibile solo per eventi futuri -->
                <LinearLayout
                    android:id="@+id/reviewFutureInfoBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#FFFFFF"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/review_restriction"
                        android:textColor="#6A1B9A"
                        android:textSize="14sp"
                        android:textStyle="italic" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="@string/date"
                            android:textColor="#1A1A2E"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/futureBoxDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="#555555"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="@string/location"
                            android:textColor="#1A1A2E"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/futureBoxLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="#555555"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="@string/city"
                            android:textColor="#1A1A2E"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/futureBoxCity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="#555555"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Sezione selezione replica (location + data) -->
                <LinearLayout
                    android:id="@+id/reviewSpinnerSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/event_location"
                        android:textColor="#6A1B9A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/reviewLocationSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/reviewDateSpinnerLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/event_date"
                        android:textColor="#6A1B9A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <Spinner
                        android:id="@+id/reviewDateSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />

                </LinearLayout>

                <RatingBar
                    android:id="@+id/reviewRatingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:numStars="5"
                    android:stepSize="1"
                    android:rating="3" />

                <EditText
                    android:id="@+id/reviewCommentInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/comment_hint"
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:maxLines="5"
                    android:minLines="2" />

                <Button
                    android:id="@+id/btnSubmitReview"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#7B1FA2"
                    android:text="@string/submit"
                    android:textColor="@android:color/white" />

            </LinearLayout>

            <!-- ── SEZIONE REPLICHE ── -->
            <CheckBox
                android:id="@+id/checkShowPastReplicas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/show_past_replicas"
                android:textColor="#6A6274"
                android:textSize="14sp"
                android:checked="false" />

            <TextView
                android:id="@+id/eventDetailReplicasLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/showing_also_at"
                android:textColor="#1A1A2E"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/eventDetailReplicasStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#9E9E9E"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Container teatri: LinearLayout statico, nessuna RecyclerView -->
            <LinearLayout
                android:id="@+id/eventDetailReplicasContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
